<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto">

    <ContentPage.ToolbarItems>
        <!-- Botão de salvar localizado na barra superior da tela -->
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Spacing="10" Padding="20">

        <!-- Campo para digitar a descrição do produto -->
        <Label Text="Descrição do Produto:" />
        <Entry x:Name="txt_descricao" Placeholder="Ex: Monitor HD" />

        <!-- Campo para digitar a quantidade -->
        <Label Text="Quantidade:" />
        <Entry x:Name="txt_quantidade" Placeholder="Ex: 2" Keyboard="Numeric" />

        <!-- Campo para digitar o preço -->
        <Label Text="Preço:" />
        <Entry x:Name="txt_preco" Placeholder="Ex: 5.99" Keyboard="Numeric" />

    </VerticalStackLayout>
</ContentPage>