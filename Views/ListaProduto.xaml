<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Lista de Compras">

    <ContentPage.ToolbarItems>
        <!-- Botão localizado na barra superior para abrir a tela de cadastro de novo item -->
        <ToolbarItem Text="Novo" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Spacing="10" Padding="20">

        <!-- Campo de busca dinâmica -->
        <SearchBar x:Name="search_bar" 
                   Placeholder="Pesquisar produto..." 
                   TextChanged="search_bar_TextChanged" />

        <!-- ListView exigida na Agenda 5 com suporte a Menu de Contexto (ContextActions) -->
        <ListView x:Name="lst_produtos" 
                  ItemSelected="lst_produtos_ItemSelected">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <!-- Menu de contexto rápido (Aparece ao segurar ou arrastar o item na lista) -->
                        <ViewCell.ContextActions>
                            <MenuItem Text="Excluir" 
                                      Clicked="MenuItem_Clicked" 
                                      IsDestructive="True" />
                        </ViewCell.ContextActions>

                        <!-- Layout visual de cada linha do produto -->
                        <VerticalStackLayout Padding="10" Spacing="5">
                            <Label Text="{Binding Descricao}" FontSize="18" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="{Binding Quantidade, StringFormat='Qtd: {0}'}" />
                                <Label Text="{Binding Preco, StringFormat='Preço: R$ {0:F2}'}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </VerticalStackLayout>
</ContentPage>